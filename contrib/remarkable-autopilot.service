# reMarkable autopilot as a systemd *user* service.
#   cp contrib/remarkable-autopilot.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now remarkable-autopilot
# Logs: journalctl --user -u remarkable-autopilot -f
[Unit]
Description=reMarkable autopilot (live tablet watcher that starts an agent)
After=network-online.target
Wants=network-online.target
# Give up after repeated crashes instead of restarting forever.
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
# User services get a minimal PATH; the agent command (e.g. claude) and uvx
# usually live in ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Install this checkout or a chosen release with uv tool install first.
# Upgrades are explicit; this unit never fetches a moving git branch.
ExecStart=%h/.local/bin/remarkable-agent-mcp-autopilot
UMask=0077
Restart=on-failure
RestartSec=30
# uvx exits 143 if it is killed before the autopilot has shut down cleanly
SuccessExitStatus=143
Nice=10
# The daemon itself needs ~150 MB; an agent run (claude -p + MCP servers) more.
MemoryMax=1200M

[Install]
WantedBy=default.target
